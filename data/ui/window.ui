<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.12"/>
  <requires lib="libadwaita" version="1.4"/>

  <template class="GoshWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">Gosh Authenticator</property>
    <property name="default-width">500</property>
    <property name="default-height">700</property>

    <child>
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <child type="start">
              <object class="GtkButton" id="refresh_button">
                <signal name="clicked" handler="on_refresh_clicked" swapped="true"/>
                <property name="icon-name">view-refresh-symbolic</property>
                <property name="tooltip-text" translatable="yes">Refresh credentials</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton" id="menu_button">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="menu-model">primary_menu</property>
                <property name="tooltip-text" translatable="yes">Main menu</property>
                <property name="primary">true</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="add_button">
                <signal name="clicked" handler="on_add_clicked" swapped="true"/>
                <property name="icon-name">list-add-symbolic</property>
                <property name="tooltip-text" translatable="yes">Add credential</property>
              </object>
            </child>
          </object>
        </child>

        <property name="content">
          <object class="AdwToastOverlay" id="toast_overlay">
            <child>
              <object class="GtkStack" id="main_stack">
                <property name="transition-type">crossfade</property>

                <!-- Empty state: No YubiKey connected -->
                <child>
                  <object class="GtkStackPage">
                    <property name="name">no-device</property>
                    <property name="child">
                      <object class="AdwStatusPage" id="no_device_page">
                        <property name="icon-name">auth-sim-missing-symbolic</property>
                        <property name="title" translatable="yes">No YubiKey Connected</property>
                        <property name="description" translatable="yes">Insert a YubiKey with OATH credentials to view your codes</property>
                      </object>
                    </property>
                  </object>
                </child>

                <!-- Empty state: No credentials -->
                <child>
                  <object class="GtkStackPage">
                    <property name="name">no-credentials</property>
                    <property name="child">
                      <object class="AdwStatusPage" id="no_credentials_page">
                        <property name="icon-name">dialog-password-symbolic</property>
                        <property name="title" translatable="yes">No Credentials</property>
                        <property name="description" translatable="yes">Add your first OATH credential to get started</property>
                        <child>
                          <object class="GtkButton" id="add_first_button">
                            <signal name="clicked" handler="on_add_first_clicked" swapped="true"/>
                            <property name="label" translatable="yes">Add Credential</property>
                            <property name="halign">center</property>
                            <style>
                              <class name="suggested-action"/>
                              <class name="pill"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>

                <!-- Loading state -->
                <child>
                  <object class="GtkStackPage">
                    <property name="name">loading</property>
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="valign">center</property>
                        <property name="halign">center</property>
                        <property name="spacing">12</property>
                        <child>
                          <object class="GtkSpinner" id="loading_spinner">
                            <property name="spinning">true</property>
                            <property name="width-request">32</property>
                            <property name="height-request">32</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="loading_label">
                            <property name="label" translatable="yes">Loading credentials...</property>
                            <style>
                              <class name="dim-label"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>

                <!-- Touch required state -->
                <child>
                  <object class="GtkStackPage">
                    <property name="name">touch-required</property>
                    <property name="child">
                      <object class="AdwStatusPage" id="touch_page">
                        <property name="icon-name">fingerprint-symbolic</property>
                        <property name="title" translatable="yes">Touch Required</property>
                        <property name="description" translatable="yes">Touch your YubiKey to generate the code</property>
                      </object>
                    </property>
                  </object>
                </child>

                <!-- Credentials list -->
                <child>
                  <object class="GtkStackPage">
                    <property name="name">credentials</property>
                    <property name="child">
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="vexpand">true</property>
                        <child>
                          <object class="AdwClamp">
                            <property name="maximum-size">600</property>
                            <property name="margin-top">12</property>
                            <property name="margin-bottom">12</property>
                            <property name="margin-start">12</property>
                            <property name="margin-end">12</property>
                            <child>
                              <object class="GtkListBox" id="credentials_list">
                                <property name="selection-mode">none</property>
                                <property name="valign">start</property>
                                <style>
                                  <class name="boxed-list"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </template>

  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_About Gosh Authenticator</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
</interface>
